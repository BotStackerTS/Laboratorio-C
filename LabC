int main(void) {

    // DECLARACION DE VARIABLES
    double v0 = 0.0;
    double y0 = 0.0;

    double a1, t1, a2, h_target;
    double v1, y1;
    double delta_y, discriminante, t2, v2;
    double t_ascenso_libre, h_max, a_mult;

    printf("========================================\n");
    printf("       SIMULADOR DE MRUV - SLS\n");
    printf("========================================\n");

    printf("Presione Enter para utilizar el valor por defecto.\n\n");

    // INGRESO DE DATOS

    a1 = leerNumero(
        "Aceleracion de la primera fase a1 (m/s^2)",
        20.0, 0.01, 1000.0
    );

    if (a1 < 0.0) {
        return 1;
    }

    t1 = leerNumero(
        "Tiempo de desacople SRB t1 (s)",
        120.0, 0.01, 10000.0
    );

    if (t1 < 0.0) {
        return 1;
    }

    a2 = leerNumero(
        "Aceleracion de la segunda fase a2 (m/s^2)",
        12.5, 0.01, 1000.0
    );

    if (a2 < 0.0) {
        return 1;
    }

    // PREGUNTA 1: PRIMERA FASE

    v1 = v0 + a1 * t1;

    y1 = y0 + v0 * t1 + 0.5 * a1 * t1 * t1;

    // INGRESO Y VALIDACION DE ALTITUD OBJETIVO

    do {

        h_target = leerNumero(
            "Altitud objetivo h (m)",
            160000.0, 0.01, 1000000000000.0
        );

        if (h_target < 0.0) {
            return 1;
        }

        if (h_target <= y1) {

            printf("\nERROR: La altitud objetivo debe ser");
            printf(" mayor que la altitud alcanzada");
            printf(" durante la primera fase.\n");

            printf("Altitud de la primera fase: %.2f m\n\n", y1);
        }

    } while (h_target <= y1);

    // PREGUNTA 2: SEGUNDA FASE

    delta_y = h_target - y1;

    discriminante = v1 * v1 + 2.0 * a2 * delta_y;

    v2 = sqrt(discriminante);

    t2 = (2.0 * delta_y) / (v1 + v2);

    // PREGUNTA 3: ASCENSO LIBRE

    t_ascenso_libre = v2 / GRAVEDAD;

    h_max = h_target + (v2 * v2) / (2.0 * GRAVEDAD);

    // PREGUNTA 4: ACELERACION COMO MULTIPLO DE G

    a_mult = a1 / GRAVEDAD;

    // PRESENTACION DE RESULTADOS

    printf("\n========================================\n");
    printf("         RESULTADOS DE LA MISION\n");
    printf("========================================\n");

    // FASE 1

    dibujarFase1();

    printf("\n1. PRIMERA FASE - DESACOPLE SRB\n");
    printf("Tiempo transcurrido: %.2f s\n", t1);
    printf("Rapidez v1: %.2f m/s\n", v1);
    printf("Altitud y1: %.2f m (%.2f km)\n",
           y1, y1 / 1000.0);

    // FASE 2

    dibujarFase2();

    printf("\n2. SEGUNDA FASE - APAGADO DE MOTORES\n");
    printf("Altitud objetivo: %.2f m\n", h_target);
    printf("Desplazamiento: %.2f m\n", delta_y);
    printf("Tiempo de segunda fase: %.2f s\n", t2);
    printf("Rapidez maxima v2: %.2f m/s\n", v2);

    // FASE 3

    dibujarFase3();

    printf("\n3. ASCENSO LIBRE\n");
    printf("Altitud de apagado: %.2f m\n", h_target);
    printf("Tiempo adicional de ascenso: %.2f s\n",
           t_ascenso_libre);
    printf("Altitud maxima h_max: %.2f m (%.2f km)\n",
           h_max, h_max / 1000.0);

    // PUNTO 4

    dibujarFase4();

    printf("\n4. ACELERACION COMO MULTIPLO DE G\n");
    printf("Aceleracion de primera fase: %.2f m/s^2\n", a1);
    printf("Gravedad terrestre: %.2f m/s^2\n", GRAVEDAD);
    printf("Equivalencia respecto de g: %.2f g\n", a_mult);

    printf("\n========================================\n");
    printf("         SIMULACION FINALIZADA\n");
    printf("========================================\n");

    return 0;
}







  

